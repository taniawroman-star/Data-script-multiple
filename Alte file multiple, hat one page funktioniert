    "# -------------------------\n",
    "# OPEN SEARCH PAGE\n",
    "# -------------------------\n",
    "\n",
    "def open_search_page(driver, jrec):\n",
    "    \"\"\"\n",
    "    Opens the CERN PhotoLab search page at a specific jrec offset.\n",
    "    \"\"\"\n",
    "    url = (\n",
    "        \"https://cds.cern.ch/search?\"\n",
    "        \"ln=en&cc=PhotoLab+Archives\"\n",
    "        \"&rg=100\"\n",
    "        \"&op1=a\"\n",
    "        \"&m1=a\"\n",
    "        f\"&jrec={jrec}\"\n",
    "    )\n",
    "    driver.get(url)\n",
    "    time.sleep(2)\n"
   ]
