    "# -------------------------\n",
    "# PAGINATION\n",
    "# -------------------------\n",
    "\n",
    "def click_next_page(driver):\n",
    "    \"\"\"\n",
    "    Clicks the 'next' arrow.\n",
    "    Returns False if no next page exists.\n",
    "    \"\"\"\n",
    "    try:\n",
    "        next_btn = WebDriverWait(driver, 10).until(\n",
    "            EC.element_to_be_clickable(\n",
    "                (By.XPATH, \"//a[img[@alt='next']]\")\n",
    "            )\n",
    "        )\n",
    "        next_btn.click()\n",
    "        time.sleep(2)\n",
    "        return True\n",
    "    except:\n",
    "        return False\n"
   ]
