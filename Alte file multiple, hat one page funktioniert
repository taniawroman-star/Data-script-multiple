    "def add_picture_row_numbers(results):\n",
    "    row_numbers = []\n",
    "    for i, r in enumerate(results, start=1):\n",
    "        img_td = r.find_all(\"td\")[0]\n",
    "        img = img_td.find(\"img\")\n",
    "        if img and img.get(\"src\"):\n",
    "            row_numbers.append(i)\n",
    "    return row_numbers\n"
   ]
